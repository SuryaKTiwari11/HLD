    },
    {
      "id": "82yHAP6aFlWT_c9wW52Uj",
      "type": "text",
      "x": 507.1275946503682,
      "y": 240.91757009872975,
      "width": 800,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6M",
      "roundness": null,
      "seed": 150171624,
      "version": 49,
      "versionNonce": 1834605936,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791225951520,
      "created": 1791215412257,
      "link": null,
      "locked": false,
      "text": "Whatsapp is a messaging service that allows users to\nsend and receive encrypted messages and calls from their\nphones and computers. Whatsapp is famously built on\nErlang and renowned for handling high scale with limited\nengineering and infrastructure outlay.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Whatsapp is a messaging service that allows users to send and receive encrypted messages and calls from their phones and computers. Whatsapp is famously built on Erlang and renowned for handling high scale with limited engineering and infrastructure outlay.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "eeGGQ1dF0RuaomHHzqafa",
      "type": "text",
      "x": 502.85189767405154,
      "y": 478.3279152855298,
      "width": 432.4598388671875,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6N",
      "roundness": null,
      "seed": 443762328,
      "version": 209,
      "versionNonce": 2027737488,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791225642806,
      "created": 1791215680795,
      "link": null,
      "locked": false,
      "text": "FUNCTIONAL REQUIREMENTS\n\n\ncreate a Group Chat\nSend/Recieve Msg\nSend/Recieve Media\nGet msg after being offline\n\nOUT OF SCOPE\nAUDIO/VIDEO CALLING",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FUNCTIONAL REQUIREMENTS\n\n\ncreate a Group Chat\nSend/Recieve Msg\nSend/Recieve Media\nGet msg after being offline\n\nOUT OF SCOPE\nAUDIO/VIDEO CALLING",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "mBmzkPS-Q3CKA4iO9Ze11",
      "type": "text",
      "x": 1004.5960385587055,
      "y": 483.31396679803834,
      "width": 499.4078369140625,
      "height": 245,
