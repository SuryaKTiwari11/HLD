    {
      "id": "SdTUOZdQ_pZQIYmiQzY8H",
      "type": "text",
      "x": 269.39996337890625,
      "y": 275.6000671386719,
      "width": 772.919677734375,
      "height": 180,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bo9",
      "roundness": null,
      "seed": 868858777,
      "version": 197,
      "versionNonce": 211038979,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791373168719,
      "created": 1791317791190,
      "link": null,
      "locked": false,
      "text": "Ticketmaster is an online platform that\nallows users to purchase tickets for\nconcerts, sports events, theater, and other\nlive entertainment.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ticketmaster is an online platform that allows users to purchase tickets for concerts, sports events, theater, and other live entertainment.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "umZSZc4a_Z3ZeFPawpx_B",
      "type": "text",
      "x": 273.60130626042667,
      "y": 473.23670600080163,
      "width": 421.84783935546875,
      "height": 180,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "boA",
      "roundness": null,
      "seed": 313190263,
      "version": 158,
      "versionNonce": 1547612845,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791373168719,
      "created": 1791318026327,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n   ->book ticket\n   ->View an event\n   ->Search for events",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n   ->book ticket\n   ->View an event\n   ->Search for events",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "X1Y8N6syX3aeOsIB_Ybbw",
      "type": "text",
      "x": 284.753159124585,
      "y": 695.469679313237,
      "width": 1355.3760550574814,
      "height": 315,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "boB",
      "roundness": null,
      "seed": 1136960025,
      "version": 747,
      "versionNonce": 305978019,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791373168719,
      "created": 1791318055717,
      "link": null,
      "locked": false,
      "text": "Non Functional Requirements\n    ->cap theorem \n        Consistency>> availability (when booking ticket) \n        availability (@ different parts when viewing an event or searching\n    ->Read:Write\n       100:1 (Read heavy)\n       scalability to handle surges @ popular events",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non Functional Requirements\n    ->cap theorem \n        Consistency>> availability (when booking ticket) \n        availability (@ different parts when viewing an event or searching\n    ->Read:Write\n       100:1 (Read heavy)\n       scalability to handle surges @ popular events",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
