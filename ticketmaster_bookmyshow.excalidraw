    {
      "id": "T2bci7Pd2Xa-M09ZFU4Rv",
      "type": "text",
      "x": 280.70797205730685,
      "y": 1631.9348603572582,
      "width": 2068.5681335819327,
      "height": 900,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "boH",
      "roundness": null,
      "seed": 1707421369,
      "version": 1342,
      "versionNonce": 228399491,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791373168719,
      "created": 1791318577442,
      "link": null,
      "locked": false,
      "text": "API \n    //this will b the one USER WILL SEE\n    //not admin\n    //user ID is very rudimentary (JWT HEADER )\n\nGet {Domain}/api/v1/{eventId}-> { Event { },ticketMap{} }\nGet {Domain}/api/v1/Search?term={INPUT}&location={venue}... time , date  -> list of partial events\nPOST {Domain}/api/v1/Booking  -> response bookingID\n    {\n        ticketId\n    } \n    //order id or booking id , whatever u wanna name it\nPOST {Domain}/api/v1/payment/{:BookingID}\n  header -> idempotency HEADER  (we dont booking twice)\n         {\n                ticketID,\n                BookingId\n                razorpay/stripe(paymentDetails)\n                \n        }",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API \n    //this will b the one USER WILL SEE\n    //not admin\n    //user ID is very rudimentary (JWT HEADER )\n\nGet {Domain}/api/v1/{eventId}-> { Event { },ticketMap{} }\nGet {Domain}/api/v1/Search?term={INPUT}&location={venue}... time , date  -> list of partial events\nPOST {Domain}/api/v1/Booking  -> response bookingID\n    {\n        ticketId\n    } \n    //order id or booking id , whatever u wanna name it\nPOST {Domain}/api/v1/payment/{:BookingID}\n  header -> idempotency HEADER  (we dont booking twice)\n         {\n                ticketID,\n                BookingId\n                razorpay/stripe(paymentDetails)\n                \n        }",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
